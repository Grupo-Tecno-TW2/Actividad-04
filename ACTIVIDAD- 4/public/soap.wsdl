<?xml version="1.0" encoding="UTF-8"?>
<definitions
    name="CatalogoServicio"
    targetNamespace="http://lab12.local/servicios"
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:tns="http://lab12.local/servicios"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">

    <types>
        <xsd:schema
            targetNamespace="http://lab12.local/servicios"
            elementFormDefault="qualified">

            <xsd:element name="obtenerProducto" type="xsd:string"/>

            <xsd:element name="obtenerProductoResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="return" type="xsd:anyType" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:schema>
    </types>

    <message name="obtenerProductoRequest">
        <part name="parameters" element="tns:obtenerProducto"/>
    </message>

    <message name="obtenerProductoResponse">
        <part name="parameters" element="tns:obtenerProductoResponse"/>
    </message>

    <portType name="CatalogoSoapPortType">
        <operation name="obtenerProducto">
            <input message="tns:obtenerProductoRequest"/>
            <output message="tns:obtenerProductoResponse"/>
        </operation>
    </portType>

    <binding name="CatalogoSoapBinding" type="tns:CatalogoSoapPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="obtenerProducto">
            <soap:operation soapAction="http://lab12.local/servicios/obtenerProducto"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <service name="CatalogoServicio">
        <port name="CatalogoSoapPort" binding="tns:CatalogoSoapBinding">
            <soap:address location="http://127.0.0.1:8001/soap.php"/>
        </port>
    </service>
</definitions>